name = ["RaM", "raj", "rose", "JACk", "PAVi"]
marks = [[44,33,90], [66,77,88], [34,56,78], [38,49,94], [38,95,72]]

pos = 1

for i in range(5):
    avg = sum(marks[i]) / 3

    if avg > 80:
        print("{}.Mr/Ms {} has scored {:.2f}% - S Grade".format(pos, name[i].title(), avg))
    elif avg > 61 and avg < 80:
        print("{}.Mr/Ms {} has scored {:.2f}% - A Grade".format(pos, name[i].title(), avg))
    elif avg > 40 and avg < 60:
        print("{}.Mr/Ms {} has scored {:.2f}% - B Grade".format(pos, name[i].title(), avg))
    else:
        print("{}.Mr/Ms {} has scored {:.2f}% - F Grade".format(pos, name[i].title(), avg))

    pos = pos + 1
